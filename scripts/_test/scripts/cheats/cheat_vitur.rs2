// A melee player holding a Scythe of Vitur, for testing the cleave without
// grinding to 75 Strength / 80 Attack and finding one — see
// content/scythe_of_vitur/README.md for the mechanic itself.
//
// Unlike ::dclaws there is no spec bar to fill: this item has no special
// attack, the cleave fires on every ordinary hit. Attack any two npcs
// standing behind each other in a line to see it.
//
// The worn slots it fills are overwritten, not swapped — whatever was in
// them is gone. It is a cheat; bank anything that matters first.

[debugproc,vitur]
if_close;
if (p_finduid(uid) = false) {
    @please_finish;
    return;
}

def_int $max_xp = 130344310;
stat_advance(attack, $max_xp);
stat_advance(defence, $max_xp);
stat_advance(strength, $max_xp);
stat_advance(hitpoints, $max_xp);

inv_setslot(worn, ^wearpos_rhand, scythe_of_vitur, 1);
inv_setslot(worn, ^wearpos_torso, rune_platebody, 1);
inv_setslot(worn, ^wearpos_legs, rune_platelegs, 1);
inv_setslot(worn, ^wearpos_hat, rune_full_helm, 1);
~update_all(null);

mes("Scythe of vitur equipped.");

// ::~viturswing — play the ported attack animation on the spot, no npc and no
// combat, the way ::dcspec does for the claws. This is the isolation that
// matters for a *ported* animation: it separates "the retarget is wrong" from
// "combat never reached the anim call", and it is the only way to watch the
// idle (scythe_of_vitur_ready) and the swing back to back.
//
// Re-fired on a queue rather than played once, so a headless capture cannot
// land in the gap after the animation ends and before the idle resumes.
[debugproc,viturswing]
if_close;
if (p_finduid(uid) = false) {
    @please_finish;
    return;
}
~viturswing_fire(20);
mes("Scythe attack animation firing on a loop.");

[proc,viturswing_fire](int $times)
anim(scythe_of_vitur_attack, 0);
if ($times > 0) {
    queue(viturswing_repeat, 3, sub($times, 1));
}

[queue,viturswing_repeat](int $times)
~viturswing_fire($times);
