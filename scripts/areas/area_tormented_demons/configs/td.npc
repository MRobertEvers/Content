// Asset lines (name/model/size/anims/vislevel/ambient/contrast/op) generated by
// 3rd/rscache/tools/port_lostcity from cache.osrs230 — see README.md in this
// area for the manifest. Combat stats, params and hunt modes are hand-authored
// from the OSRS fight data and are NOT regenerated, so re-running the exporter
// overwrites this file and they have to be put back.
//
// Two entries, one per body model. The fire shield is geometry on the demon,
// not an overlay: 53287 carries it and 53285 does not, which is why dropping
// the shield is an npc_changetype rather than a spotanim. Everything else about
// the pair is identical, and `npc_changetype_keepall` is what carries the
// hitpoints and the fight state across the swap.
//
// The defence bonuses are the wiki's: stab 75, slash 175, crush 68, magic 5,
// ranged 150 — it is softest to crush and to magic, which is the whole reason
// the fight is worth bringing two styles to.

[td_demon]
name=Tormented Demon
model1=td_model_53287
size=3
readyanim=td_ready
walkanim=td_walk
vislevel=450
ambient=10
contrast=25
op2=Attack
timer=1
hitpoints=600
attack=255
strength=255
defence=150
magic=255
ranged=255
attackrange=8
maxrange=10
wanderrange=4
huntrange=10
huntmode=td_demon
respawnrate=21
param=attackrate,6
param=attack_anim,td_melee
param=defend_anim,td_defend
param=death_anim,td_death
param=stabdefence,75
param=slashdefence,175
param=crushdefence,68
param=magicdefence,5
param=rangedefence,150

