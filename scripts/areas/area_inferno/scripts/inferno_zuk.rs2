// TzKal-Zuk, ported from Kronos' TzKalZuk.java.
//
// Zuk never moves and never misses: his shot ignores prayer and defence, and the
// only thing that stops it is standing behind the Ancestral Glyph as it slides
// across the arena. Everything else — the ranger/mager waves, the Jad phase and
// the healer phase — hangs off his HP and his tick timer, so the whole fight is
// driven from one ai_timer rather than from the normal combat modes.

//! Entry point. `::~zuk` starts the fight at full health; `::~zuk 470` starts it
//! already damaged, which is how the Jad (<=480) and healer (<=240) phases are
//! reached without grinding through 1200 hitpoints first.
[debugproc,zuk](int $hp)
if_close;
if (p_finduid(uid) = false) {
    return;
}
~inferno_despawn_all(^inferno_zuk_coord);
p_teleport(^inferno_player_coord);
// The rocks either side of him, which the square's loc data does not carry at
// all — Kronos puts them in when it builds the arena and drops the marker that
// stands where they go. Level 1, which is why they read as the tall formations
// flanking him rather than as anything on the floor.
~inferno_break_seal(^inferno_flank_marker_coord, inferno_loc_30356);
loc_add(^inferno_flank_coord_west, inferno_loc_30346, ^inferno_flank_angle, centrepiece_straight, ^inferno_npc_duration);
loc_add(^inferno_flank_coord_east, inferno_loc_30345, ^inferno_flank_angle, centrepiece_straight, ^inferno_npc_duration);
// Break the seal. Zuk comes out of the wall, so none of what was holding him
// in is still standing once the fight is on. The glyph goes outright; the two
// rocks are given a collapse first — each swaps to its "Falling rock" twin
// here and is animated and cleared from the queue below.
~inferno_break_seal(^inferno_glyph_loc_coord, inferno_loc_30338);
~inferno_collapse_rock(^inferno_rock_coord_west, inferno_loc_30337, inferno_loc_30344);
~inferno_collapse_rock(^inferno_rock_coord_east, inferno_loc_30336, inferno_loc_30343);
// Queued unconditionally, so a run that was interrupted mid-collapse still has
// its leftover falling rocks cleared by the next ::~zuk.
queue(inferno_seal_anim, ^inferno_seal_anim_delay, 0);
// The glyph first, so Zuk's first tick already finds it. It goes in on the
// seal row and drops to its own row over the opening ticks.
npc_add(^inferno_glyph_spawn_coord, inferno_zuk_shield, ^inferno_npc_duration);
npc_add(^inferno_zuk_coord, inferno_zuk, ^inferno_npc_duration);
// npc_add leaves the npc it made active, so the opening damage can be queued
// straight onto him. It goes through ai_queue2 so the phase checks see it as
// ordinary damage.
if ($hp > 0 & $hp < npc_basestat(hitpoints)) {
    npc_queue(2, sub(npc_basestat(hitpoints), $hp), 1);
}
mes("TzKal-Zuk stirs.");
// Put the number up before anyone has hit him, so it is on screen from the
// start rather than appearing out of nowhere on the first hitsplat. After the
// announcement, so the fight reads in the order it happens.
~inferno_report_health("TzKal-Zuk", npc_stat(hitpoints));
// Last, because it holds the player for ten ticks. Everything it wants to show
// — Zuk's spawn animation, the seal coming down, the glyph dropping clear — is
// already queued and plays out underneath it.
~inferno_cutscene;

/**
 * The opening: the camera pulls back to the mouth of the arena, turns on Zuk
 * and shakes while he tears his way out, then hands control back.
 *
 * `p_delay` is the lock as well as the pacing — it suspends this script and
 * leaves the player unable to act for the duration, which is what Kronos gets
 * from locking them explicitly.
 *
 * Kronos plays the line as dialogue from TzHaar-Ket-Rak (npc 7690, animation
 * 615). Nothing of him is ported — he is not in the arena and his chathead is
 * not in the export — so it is a game message here rather than a talking head.
 */
[proc,inferno_cutscene]
cam_moveto(^inferno_cam_from, ^inferno_cam_height, ^inferno_cam_rate, ^inferno_cam_rate2);
cam_lookat(^inferno_cam_to, ^inferno_cam_height, ^inferno_cam_rate, ^inferno_cam_rate2);
cam_shake(0, ^inferno_shake_jitter, ^inferno_shake_amplitude, ^inferno_shake_frequency);
cam_shake(1, ^inferno_shake_jitter, ^inferno_shake_amplitude, ^inferno_shake_frequency);
cam_shake(2, ^inferno_shake_jitter, ^inferno_shake_amplitude, ^inferno_shake_frequency);
mes("Oh no! TzKal-Zuk's prison is breaking down. This not meant to have happened.");
mes("There's nothing I can do for you now JalYt!");
p_delay(^inferno_cutscene_ticks);
cam_reset;

/**
 * Take one piece of the seal down. Idempotent, because a second ::~zuk finds
 * the loc already gone and there is nothing left to remove.
 */
[proc,inferno_break_seal](coord $coord, loc $loc)
if (loc_find($coord, $loc) = true) {
    loc_del(^inferno_npc_duration);
}

/**
 * Start a rock collapsing: swap the standing loc for its "Falling rock" twin.
 * The change lasts the whole encounter, but the rock is cleared long before
 * that — the duration is only there so it cannot revert mid-fight.
 */
[proc,inferno_collapse_rock](coord $coord, loc $standing, loc $falling)
if (loc_find($coord, $standing) = true) {
    loc_change($falling, ^inferno_npc_duration);
}

// The rocks let go, and are cleared as the animation finishes.
[queue,inferno_seal_anim]
~inferno_anim_rock(^inferno_rock_coord_west, inferno_loc_30344);
~inferno_anim_rock(^inferno_rock_coord_east, inferno_loc_30343);
queue(inferno_seal_clear, ^inferno_seal_clear_delay, 0);

[queue,inferno_seal_clear]
~inferno_break_seal(^inferno_rock_coord_west, inferno_loc_30344);
~inferno_break_seal(^inferno_rock_coord_east, inferno_loc_30343);
// What the collapse leaves behind. The rocks do not simply vanish: one of the
// standing pieces drops to its low form where it was, and three low ones are
// added around it, so the alcove reads as broken rather than swept.
if (loc_find(^inferno_rubble_change_coord, inferno_loc_30332) = true) {
    loc_change(inferno_loc_30339, ^inferno_npc_duration);
}
~inferno_rubble(^inferno_rubble_coord_west_near, inferno_loc_30340, ^inferno_rubble_angle_west);
~inferno_rubble(^inferno_rubble_coord_west_far, inferno_loc_30342, ^inferno_rubble_angle_west);
~inferno_rubble(^inferno_rubble_coord_east_far, inferno_loc_30341, ^inferno_rubble_angle_east);

/**
 * Drop one piece of low rock. Spawned rather than changed — these have nothing
 * standing in their place to begin with, they are only there once Zuk is out.
 */
[proc,inferno_rubble](coord $coord, loc $loc, int $angle)
loc_add($coord, $loc, $angle, centrepiece_straight, ^inferno_npc_duration);

[proc,inferno_anim_rock](coord $coord, loc $loc)
if (loc_find($coord, $loc) = true) {
    loc_anim(inferno_seal_collapse);
}

// Remove every encounter npc around a coord. Used on entry, so a second ::zuk
// does not stack a fight on top of the last one.
[proc,inferno_despawn_all](coord $coord)
npc_findallany($coord, ^inferno_scan_range, ^vis_off);
while (npc_findnext = true) {
    if (npc_type = inferno_zuk | npc_type = inferno_zuk_shield | npc_type = inferno_mejjak |
        npc_type = inferno_jad | npc_type = inferno_hurkot | npc_type = inferno_xil |
        npc_type = inferno_zek) {
        npc_del;
    }
}

// ---- Zuk's cycle --------------------------------------------------------

[ai_timer,inferno_zuk]
// He arrives sealed. Kronos locks him for the opening cutscene and unlocks him
// once the dialogue is done, so the first thing he does is haul himself out of
// the wall — no timer, no waves, no shot until that has played out. The glyph
// is dropping clear of the seal over the same ticks.
if (%inferno_zuk_emerged ! 1) {
    %inferno_zuk_emerged = 1;
    %inferno_cooldown = add(map_clock, ^inferno_zuk_spawn_delay);
    npc_anim(inferno_zuk_spawn, 0);
    return;
}
if (%inferno_cooldown > map_clock) {
    return;
}

// Everything that touches the glyph stays inside the branch where the lookup
// succeeded — the script compiler tracks whether the secondary npc slot is
// live, and a stored "did I find it" flag is not enough to convince it.
if (.npc_find(npc_coord, inferno_zuk_shield, ^inferno_scan_range, ^vis_off) = true) {
    def_int $glyph_x = coordx(.npc_coord);
    def_int $glyph_dir = .%inferno_glyph_dir;

    // Zuk holds fire until the glyph has completed its first pass.
    if (%inferno_zuk_ready ! 1 &
        ($glyph_x = ^inferno_glyph_west_x | $glyph_x = ^inferno_glyph_east_x)) {
        %inferno_zuk_ready = 1;
    }
    if (%inferno_zuk_ready ! 1) {
        return;
    }
    ~inferno_wave_tick;
    if (%npc_action_delay > map_clock) {
        return;
    }

    huntall(npc_coord, ^inferno_scan_range, ^vis_off);
    while (huntnext = true) {
        %npc_action_delay = add(map_clock, ~inferno_zuk_attackrate);
        npc_anim(npc_param(attack_anim), 0);
        if (~inferno_zuk_safe($glyph_x, $glyph_dir, coordx(coord)) = true) {
            // Blocked: the shot goes to the glyph and the player takes nothing.
            def_int $blocked = ~npc_to_npc_projectile(.npc_uid, inferno_zuk_proj, 80, 31, 56, 16, 36, 64, 8);
            .npc_anim(inferno_shield_defend, $blocked);
            return;
        }
        ~inferno_zuk_shoot;
        return;
    }
    return;
}

// No glyph left — it was killed, so nothing blocks any more.
if (%inferno_zuk_ready ! 1) {
    return;
}
~inferno_wave_tick;
if (%npc_action_delay > map_clock) {
    return;
}
huntall(npc_coord, ^inferno_scan_range, ^vis_off);
while (huntnext = true) {
    %npc_action_delay = add(map_clock, ^inferno_zuk_attackrate);
    npc_anim(npc_param(attack_anim), 0);
    ~inferno_zuk_shoot;
    return;
}

/**
 * Ticks between shots. Ten until the healer threshold, seven after it: Zuk
 * enrages as he fights for his life, and the three ticks he gains are what
 * close the two middle safespots — from there on the player has to stay level
 * with the glyph instead of crossing behind it between shots.
 *
 * It is a latch, not a comparison. The Jal-MejJak that arrive at the same
 * threshold spend the rest of the fight healing him back above it, and reading
 * his health live would have him lapse in and out of the enrage every time
 * they landed one.
 */
[proc,inferno_zuk_attackrate]()(int)
if (npc_stat(hitpoints) <= ^inferno_healers_hp) {
    %inferno_zuk_enraged = 1;
}
if (%inferno_zuk_enraged = 1) {
    return(^inferno_zuk_attackrate_enraged);
}
return(^inferno_zuk_attackrate);

// The unblocked shot. Ignores prayer and defence — there is no roll to make.
[proc,inferno_zuk_shoot]
if_close;
def_int $duration = ~player_projectile(npc_coord, coord, uid, inferno_zuk_proj, 80, 31, 56, 16, 36, 64, 8);
anim(%com_defendanim, $duration);
queue(combat_damage_player, calc($duration / 30), random(calc(^inferno_zuk_maxhit + 1)));
queue*(playerhit_n_retaliate, calc($duration / 30))(npc_uid);
~npc_set_attack_vars;

/**
 * Report a combatant's health to everyone in the arena as a chat line. Shared
 * by Zuk and the glyph — neither is easy to read a health bar off, Zuk because
 * he is at the far end of the arena and the glyph because you are usually
 * standing under it.
 *
 * Called with the health the current hit will leave rather than the health the
 * npc has now, so the number matches the hitsplat it arrives with instead of
 * trailing it by one. The total comes off the active npc, which must therefore
 * be the one being reported.
 *
 * The hunt loop is not for finding a target — it is the only way to get an
 * active player at all. A queued npc script runs with none, so there is nobody
 * for `mes` to talk to until the arena is walked for one.
 */
[proc,inferno_report_health](string $who, int $hp)
def_string $report = "<$who>: <tostring($hp)>/<tostring(npc_basestat(hitpoints))>";
huntall(npc_coord, ^inferno_scan_range, ^vis_off);
while (huntnext = true) {
    mes($report);
}

/**
 * Is the player standing in the glyph's shadow?
 *
 * The band is the glyph's own three tiles, widened by where it is heading: a
 * moving glyph covers more ground behind it than in front, and one parked at
 * either end covers one extra tile on its outward side. Offsets are Kronos'.
 */
[proc,inferno_zuk_safe](int $glyph_x, int $glyph_dir, int $player_x)(boolean)
def_int $min = $glyph_x;
def_int $max = calc($glyph_x + 2);
if ($glyph_x = ^inferno_glyph_west_x) {
    $max = calc($max + 1);
} else if ($glyph_x = ^inferno_glyph_east_x) {
    $min = calc($min - 1);
} else if ($glyph_dir = ^inferno_dir_west) {
    $max = calc($max + 2);
    $min = calc($min - 3);
} else {
    $min = calc($min - 2);
    $max = calc($max + 3);
}
if ($player_x >= $min & $player_x <= $max) {
    return(true);
}
return(false);

// ---- add waves ----------------------------------------------------------

// Called once per tick from Zuk's timer. The first wave lands 60 ticks after the
// glyph is ready; every wave after that is at least 350 apart, and Jad's arrival
// stretches the gap further. Spawning stops entirely while Zuk sits in the band
// just above the Jad threshold.
[proc,inferno_wave_tick]
if (%inferno_wave_time = 0) {
    %inferno_wave_time = ^inferno_wave_first;
}
// The gap where the waves stop coming, and the reason players leave the mager
// alive: the timer holds from the tick Zuk first drops under 600 until he first
// drops under 480, which is the window you get to spawn Jad and kill it in.
//
// Latched rather than a live band check, and one-way. The Jal-MejJak heal him
// back up hundreds of hitpoints, so a comparison would drag him back through
// the band later in the fight and stop the waves a second time.
if (%inferno_wave_gate = ^inferno_wave_gate_before &
    npc_stat(hitpoints) < ^inferno_wave_pause_hp) {
    %inferno_wave_gate = ^inferno_wave_gate_paused;
}
if (%inferno_wave_gate = ^inferno_wave_gate_paused &
    npc_stat(hitpoints) < ^inferno_wave_resume_hp) {
    %inferno_wave_gate = ^inferno_wave_gate_resumed;
}
if (%inferno_wave_gate = ^inferno_wave_gate_paused) {
    return;
}
%inferno_wave_timer = add(%inferno_wave_timer, 1);
if (%inferno_wave_timer < %inferno_wave_time) {
    return;
}
%inferno_wave_timer = 0;
%inferno_wave_time = max(%inferno_wave_time, ^inferno_wave_interval);
.npc_add(^inferno_mager_coord, inferno_zek, ^inferno_npc_duration);
.npc_add(^inferno_ranger_coord, inferno_xil, ^inferno_npc_duration);

// ---- phases -------------------------------------------------------------

// Damage drives the phases, so they are checked where the damage lands rather
// than on the timer — a single big hit must not skip a threshold.
[ai_queue2,inferno_zuk]
def_int $damage = last_int;
// The phases are decided from the health this hit *will* leave, and applied
// before the damage itself, because ~npc_default_damage returns out of the
// trigger on its own early exits — anything written after the call never runs.
def_int $after = max(sub(npc_stat(hitpoints), $damage), 0);
// Report it on the glyph. Zuk stands at the far end of the arena, too far off
// to read a hitsplat from and much too far to make out a health bar over, but
// the glyph is the one thing in the fight that is always next to the player —
// following it is the fight — so his health is written above that instead.
// Every hit updates it, a blocked one included, because a zero still tells you
// the shot landed on you rather than on him.
~inferno_report_health("TzKal-Zuk", $after);
if ($after > 0) {
    // Latched here as well as at the attack, so a dip under the threshold that
    // a healer undoes before his next shot still enrages him.
    if ($after <= ^inferno_healers_hp) {
        %inferno_zuk_enraged = 1;
    }
    if (%inferno_jad_spawned ! 1 & $after <= ^inferno_jad_hp) {
        %inferno_jad_spawned = 1;
        %inferno_wave_time = add(%inferno_wave_time, ^inferno_wave_jad_delay);
        .npc_add(^inferno_jad_coord, inferno_jad, ^inferno_npc_duration);
    } else if (%inferno_healers_spawned ! 1 & $after <= ^inferno_healers_hp) {
        %inferno_healers_spawned = 1;
        .npc_add(^inferno_healer_coord1, inferno_mejjak, ^inferno_npc_duration);
        .npc_add(^inferno_healer_coord2, inferno_mejjak, ^inferno_npc_duration);
        .npc_add(^inferno_healer_coord3, inferno_mejjak, ^inferno_npc_duration);
        .npc_add(^inferno_healer_coord4, inferno_mejjak, ^inferno_npc_duration);
    }
}
~npc_default_damage($damage);

// Zuk taking a heal from a Jal-MejJak. It arrives as a queued amount rather than
// a direct write because there is no secondary-slot npc_statheal — a healer can
// only ask its target to heal itself.
[ai_queue4,inferno_zuk]
npc_statheal(hitpoints, last_int, 0);

[ai_queue3,inferno_zuk]
npc_anim(npc_param(death_anim), 0);
// The fight is over; nothing else in the arena has anything left to do.
.npc_findallany(npc_coord, ^inferno_scan_range, ^vis_off);
while (.npc_findnext = true) {
    if (.npc_type = inferno_zuk_shield | .npc_type = inferno_mejjak | .npc_type = inferno_jad |
        .npc_type = inferno_hurkot | .npc_type = inferno_xil | .npc_type = inferno_zek) {
        .npc_del;
    }
}
gosub(npc_default_death);

// ---- neutered defaults --------------------------------------------------
//
// Zuk is stationary and fires only from his own timer, so the stock combat modes
// must not take him over: retaliating would make him chase, and opplayer2 would
// have him swing a melee attack he does not own.

[ai_queue1,inferno_zuk]
npc_setmode(none);

[ai_opplayer2,inferno_zuk]
npc_setmode(none);

[ai_applayer2,inferno_zuk]
npc_setmode(none);

//! Drive Zuk to a given health so a phase can be reached without a full fight,
//! and drop the caller into the arena to watch it. ::~zukhp 470 spawns Jad,
//! ::~zukhp 230 the healers, ::~zukhp 0 kills him. Needs a fight already running.
[debugproc,zukhp](int $hp)
if_close;
if (p_finduid(uid) = false) {
    return;
}
p_teleport(^inferno_player_coord);
// Searched around the arena rather than around the player, so it works from
// anywhere — including a session that did not start the fight.
npc_findallany(^inferno_zuk_coord, ^inferno_scan_range, ^vis_off);
while (npc_findnext = true) {
    if (npc_type = inferno_zuk) {
        // Routed through the damage queue rather than npc_statsub so it goes
        // past the phase checks exactly as real damage would.
        mes("TzKal-Zuk <tostring(npc_stat(hitpoints))> -> <tostring(max($hp, 0))>");
        npc_queue(2, sub(npc_stat(hitpoints), max($hp, 0)), 0);
        return;
    }
}
mes("No TzKal-Zuk nearby.");

//! Drive JalTok-Jad to a given health the same way, so its Yt-HurKot can be
//! reached without fighting it down by hand. ::~jadhp 170 puts it under half
//! and spawns the three healers; running it again does nothing, which is the
//! point — healing back over half must not buy a second set.
[debugproc,jadhp](int $hp)
if_close;
if (p_finduid(uid) = false) {
    return;
}
p_teleport(^inferno_player_coord);
npc_findallany(^inferno_zuk_coord, ^inferno_scan_range, ^vis_off);
while (npc_findnext = true) {
    if (npc_type = inferno_jad) {
        mes("JalTok-Jad <tostring(npc_stat(hitpoints))> -> <tostring(max($hp, 0))>");
        npc_queue(2, sub(npc_stat(hitpoints), max($hp, 0)), 0);
        return;
    }
}
// Self-contained, like ::~tagheal: no Jad means put one in and damage that, so
// the healer phase is one command away rather than three. Nothing else in the
// arena is needed — Jad finds the player on its own.
mes("No JalTok-Jad nearby; spawning one.");
npc_add(^inferno_jad_coord, inferno_jad, ^inferno_npc_duration);
npc_queue(2, sub(npc_stat(hitpoints), max($hp, 0)), 1);

//! Poke every healer in the arena — Zuk's Jal-MejJak and Jad's Yt-HurKot — for
//! a single point of damage, which is all it takes to turn one. Both kinds heal
//! until they are hit; the Jal-MejJak then bombard the arena and the Yt-HurKot
//! come after you. There is no other way to provoke one without standing in the
//! arena swinging at it.
[debugproc,tagheal]
if_close;
if (p_finduid(uid) = false) {
    return;
}
p_teleport(^inferno_healer_watch_coord);
// Self-contained: if the fight has not reached the healer phase, put the four
// Jal-MejJak on the shelf where it would have. Reaching them the long way round
// means three commands and three logins, and a healer that is already angry
// never looks for Zuk again, so it does not need him to exist.
def_int $present = 0;
npc_findallany(^inferno_zuk_coord, ^inferno_scan_range, ^vis_off);
while (npc_findnext = true) {
    if (npc_type = inferno_mejjak | npc_type = inferno_hurkot) {
        $present = add($present, 1);
    }
}
if ($present = 0) {
    // Zuk first, and he is not optional: a healer with nothing to heal deletes
    // itself on its very first tick, and ai_timer runs ahead of ai_queue, so
    // healers spawned on their own are gone before the tag below can land.
    // Without a glyph he never becomes ready, so he stands there inert and the
    // test is only ever about the healers.
    npc_add(^inferno_zuk_coord, inferno_zuk, ^inferno_npc_duration);
    npc_add(^inferno_healer_coord1, inferno_mejjak, ^inferno_npc_duration);
    npc_add(^inferno_healer_coord2, inferno_mejjak, ^inferno_npc_duration);
    npc_add(^inferno_healer_coord3, inferno_mejjak, ^inferno_npc_duration);
    npc_add(^inferno_healer_coord4, inferno_mejjak, ^inferno_npc_duration);
}
// All of them, not the first one found: they are spread across the width of the
// shelf and only reach six tiles, so tagging whichever turned up first would
// often turn one that cannot see the player and look like nothing happened.
def_int $tagged = 0;
npc_findallany(^inferno_zuk_coord, ^inferno_scan_range, ^vis_off);
while (npc_findnext = true) {
    if (npc_type = inferno_mejjak | npc_type = inferno_hurkot) {
        // Both halves of what a real attack does: the damage, and the note of
        // who dealt it. A healer shoots back at whoever is recorded there, so
        // queueing the damage on its own would turn it and leave it with
        // nobody to aim at.
        %npc_aggressive_player = uid;
        npc_queue(2, 1, 0);
        $tagged = add($tagged, 1);
    }
}
if ($tagged = 0) {
    mes("No healers nearby.");
    return;
}
mes("Tagged <tostring($tagged)> healer(s).");
