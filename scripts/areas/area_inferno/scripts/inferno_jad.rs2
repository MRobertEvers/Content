// JalTok-Jad, the ~40% phase, ported from Kronos' JalTokJad.java.
//
// Nine-tick cycle: melee if the player is adjacent (a third of the time), and
// otherwise an even split between the magic tri-projectile and the ranged
// ground graphic. At half health it calls in three Yt-HurKot to heal it.

[ai_timer,inferno_jad]
// The glyph check comes ahead of the attack cooldown, so the tick it dies is
// the tick Jad turns on the player rather than up to nine ticks later.
if (%inferno_add_angry ! 1 &
    .npc_find(npc_coord, inferno_zuk_shield, ^inferno_scan_range, ^vis_off) = false) {
    ~inferno_add_provoked;
}
if (%npc_action_delay > map_clock) {
    return;
}
// Like the wave adds, Jad arrives pointed at the glyph and stays there until
// the player hits it — and it hits far harder than they do, which is why
// tagging it is the first thing you do when it lands. Jad hunts nothing: it
// finds the player through its own huntall below, so being provoked only has
// to flip the flag.
if (%inferno_add_angry ! 1) {
    if (.npc_find(npc_coord, inferno_zuk_shield, ^inferno_scan_range, ^vis_off) = true) {
        %npc_action_delay = add(map_clock, npc_param(attackrate));
        npc_facesquare(.npc_coord);
        npc_anim(inferno_jad_magic, 0);
        spotanim_npc(inferno_jad_magic_gfx, 0, 60);
        def_int $glyph_hit = ~npc_to_npc_projectile(.npc_uid, inferno_jad_proj1, 128, 31, 62, 16, 10, 32, 8);
        ~npc_to_npc_projectile(.npc_uid, inferno_jad_proj2, 128, 31, 66, 16, 14, 32, 8);
        ~npc_to_npc_projectile(.npc_uid, inferno_jad_proj3, 128, 31, 70, 16, 20, 32, 8);
        .npc_queue(2, randominc(^inferno_jad_maxhit), calc($glyph_hit / 30));
        return;
    }
    // No glyph left to shoot; the player is all that is here.
    ~inferno_add_provoked;
}
huntall(npc_coord, ^inferno_scan_range, ^vis_off);
while (huntnext = true) {
    // npc_attackrange reads the config field; the param of the same name is a
    // different thing that nothing here sets, and reading it gave 0, so this
    // was "further away than zero tiles" — always true, and Jad walked at the
    // player forever instead of ever attacking.
    if (npc_range(coord) > npc_attackrange) {
        // Out of range: walk toward the player instead of attacking.
        if (%inferno_cooldown <= map_clock) {
            %inferno_cooldown = add(map_clock, 2);
            npc_walk(coord);
        }
        return;
    }
    %npc_action_delay = add(map_clock, npc_param(attackrate));
    npc_facesquare(coord);

    if (npc_range(coord) <= 1 & random(3) = 0) {
        npc_anim(npc_param(attack_anim), 0);
        ~inferno_hit_player(0, ^crush_style, ^inferno_jad_maxhit);
        return;
    }
    if (random(2) = 0) {
        ~inferno_jad_magic;
        return;
    }
    ~inferno_jad_range;
    return;
}

// Three projectiles chase each other along the same line; the first one's flight
// time is what the damage is scheduled against.
[proc,inferno_jad_magic]
npc_anim(inferno_jad_magic, 0);
spotanim_npc(inferno_jad_magic_gfx, 0, 60);
def_int $duration = ~player_projectile(npc_coord, coord, uid, inferno_jad_proj1, 128, 31, 62, 16, 10, 32, 8);
def_int $trail1 = ~player_projectile(npc_coord, coord, uid, inferno_jad_proj2, 128, 31, 66, 16, 14, 32, 8);
def_int $trail2 = ~player_projectile(npc_coord, coord, uid, inferno_jad_proj3, 128, 31, 70, 16, 20, 32, 8);
~inferno_hit_player($duration, ^magic_style, ^inferno_jad_maxhit);

// The ranged attack has no projectile at all — it drops a graphic on the tile the
// player is standing on and lands two ticks later.
[proc,inferno_jad_range]
npc_anim(inferno_jad_range, 0);
spotanim_map(inferno_jad_range_gfx, coord, 0, 0);
~inferno_hit_player(60, ^ranged_style, ^inferno_jad_maxhit);

/**
 * Damage the active player after `$duration` client cycles.
 *
 * Shared by Jad, the ranger and the mager. Protection prayers work here (unlike
 * against Zuk), and the impact graphic is Jad's for every source because that is
 * what Kronos plays.
 */
[proc,inferno_hit_player](int $duration, int $style, int $maxhit)
if_close;
def_int $damage = randominc($maxhit);
if (~check_protect_prayer($style) = true) {
    $damage = 0;
}
anim(%com_defendanim, $duration);
spotanim_pl(inferno_jad_hit, 0, $duration);
queue(combat_damage_player, calc($duration / 30), $damage);
queue*(playerhit_n_retaliate, calc($duration / 30))(npc_uid);
~npc_set_attack_vars;

// ---- healers ------------------------------------------------------------

[ai_queue2,inferno_jad]
// Being hit is what takes Jad off the glyph, exactly as it is for the adds.
~inferno_add_provoked;
def_int $damage = last_int;
// Decided before the damage lands, for the same reason as Zuk's: the default
// damage proc can return out of the whole trigger.
def_int $after = max(sub(npc_stat(hitpoints), $damage), 0);
// Latched, so healing Jad back over half does not buy a second set.
if ($after > 0 & %inferno_jad_healers_spawned ! 1 &
    $after < divide(npc_basestat(hitpoints), 2)) {
    %inferno_jad_healers_spawned = 1;
    ~inferno_jad_spawn_healer;
    ~inferno_jad_spawn_healer;
    ~inferno_jad_spawn_healer;
}
~npc_default_damage($damage);

/**
 * One Yt-HurKot. Three of these, and only three — Kronos hands out five only on
 * wave 67, and Zuk is wave 69.
 *
 * Wave 69 "always spawns healers to the north": the spawn area is the three by
 * three square centred five tiles north of Jad's own centre, and each healer is
 * drawn from it independently, so two can land on the same tile. They walk to
 * Jad from wherever they appear, which is what the Yt-HurKot timer does.
 */
[proc,inferno_jad_spawn_healer]
def_coord $centre = movecoord(npc_coord, ^inferno_jad_healer_dx, 0, ^inferno_jad_healer_dz);
.npc_add(
    movecoord($centre, sub(random(3), 1), 0, sub(random(3), 1)),
    inferno_hurkot,
    ^inferno_npc_duration);

// Heals arrive as a queued amount rather than a direct write, because there is no
// secondary-slot npc_statheal — a healer can only ask its target to heal itself.
[ai_queue4,inferno_jad]
npc_statheal(hitpoints, last_int, 0);

[ai_queue3,inferno_jad]
npc_anim(npc_param(death_anim), 0);
// Jad's healers have nothing left to heal, but they go with him rather than
// before him: each is asked to remove itself once his death has finished
// playing, so they are still standing there while he goes down.
.npc_findallany(npc_coord, ^inferno_scan_range, ^vis_off);
while (.npc_findnext = true) {
    if (.npc_type = inferno_hurkot) {
        .npc_queue(5, 0, ^inferno_jad_death_ticks);
    }
}
gosub(npc_default_death);

// Jad's death has played out — but he is not gone the instant it finishes. The
// stock death path walks him, waits for him to arrive, plays the animation and
// only then removes him, and how long that adds is not ours to know. So poll
// rather than trust a count: the healers stand there until he has actually
// left, and go on the tick after.
[ai_queue5,inferno_hurkot]
if (.npc_find(npc_coord, inferno_jad, ^inferno_scan_range, ^vis_off) = true) {
    npc_queue(5, 0, 1);
    return;
}
npc_del;

// ---- Yt-HurKot ----------------------------------------------------------
//
// They ignore the player entirely: walk to Jad, then top it up every four ticks.

[ai_timer,inferno_hurkot]
// Tagged: it gives up on Jad and goes after whoever hit it, walking them down
// first if it has to. Same latch as Zuk's healers, and for the same reason —
// leaving them alive to top Jad up is what makes the phase drag.
if (%inferno_healer_angry = 1) {
    if (p_finduid(%inferno_healer_target) = false) {
        return;
    }
    %inferno_healer_range = npc_range(coord);
    if (%inferno_healer_range > npc_attackrange) {
        if (%inferno_cooldown <= map_clock) {
            %inferno_cooldown = add(map_clock, 2);
            npc_walk(coord);
        }
        return;
    }
    if (%npc_action_delay > map_clock) {
        return;
    }
    %npc_action_delay = add(map_clock, npc_param(attackrate));
    npc_facesquare(coord);
    npc_anim(npc_param(attack_anim), 0);
    ~inferno_hit_player(0, ^crush_style, ^inferno_hurkot_maxhit);
    return;
}

if (.npc_find(npc_coord, inferno_jad, ^inferno_scan_range, ^vis_off) = true) {
    if (npc_range(.npc_coord) > 1) {
        if (%inferno_cooldown <= map_clock) {
            %inferno_cooldown = add(map_clock, 2);
            npc_walk(.npc_coord);
        }
        return;
    }
    if (%npc_action_delay > map_clock) {
        return;
    }
    %npc_action_delay = add(map_clock, ^inferno_hurkot_heal_rate);
    npc_facesquare(.npc_coord);
    npc_anim(inferno_hurkot_heal, 0);
    .spotanim_npc(inferno_hurkot_heal_gfx, 0, 0);
    .npc_queue(4, randominc(10), 0);
    return;
}
// Nothing left to heal.
npc_del;

[ai_queue2,inferno_hurkot]
// Set before the damage lands — ~npc_default_damage can return out of the
// trigger, so anything after the call is unreachable.
~inferno_healer_provoked;
~npc_default_damage(last_int);

[ai_queue1,inferno_hurkot]
~inferno_healer_provoked;
npc_setmode(none);

[ai_opplayer2,inferno_hurkot]
npc_setmode(none);

[ai_applayer2,inferno_hurkot]
npc_setmode(none);
