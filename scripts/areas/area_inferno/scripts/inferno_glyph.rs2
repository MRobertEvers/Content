// The Ancestral Glyph — Zuk's moving safespot.
//
// It slides one tile a tick between the two ends of the row in front of Zuk,
// waits four ticks at each end, and turns around. Zuk reads its position and
// heading every tick; killing it takes the safespot away for good.

[ai_timer,inferno_zuk_shield]
// npc_add hands back no reference, so the glyph seeds its own state: direction
// zero means "never started", which is why the direction constants begin at 1.
//
// Before any of that it has to get out of the seal. It spawns two rows north
// of its run, inside the pillars along Zuk's row, and drops clear of them as
// he breaks out — Kronos pauses three ticks and then force-walks it south
// twice. Only once it is on the row does the sweep begin.
if (%inferno_glyph_dir = 0) {
    %inferno_glyph_stopped = add(%inferno_glyph_stopped, 1);
    if (%inferno_glyph_stopped <= ^inferno_glyph_drop_delay) {
        return;
    }
    if (coordz(npc_coord) > ^inferno_glyph_row_z) {
        npc_walk(^inferno_glyph_run_coord);
        return;
    }
    %inferno_glyph_stopped = 0;
    %inferno_glyph_dir = ^inferno_dir_west;
    npc_walk(^inferno_glyph_west);
    return;
}

def_int $target_x = ^inferno_glyph_west_x;
if (%inferno_glyph_dir = ^inferno_dir_east) {
    $target_x = ^inferno_glyph_east_x;
}

if (coordx(npc_coord) ! $target_x) {
    %inferno_glyph_stopped = 0;
    // Re-issue the walk periodically. Anything that clears the npc's queued
    // movement — being attacked, a failed step — would otherwise strand it
    // mid-row, and a stranded glyph is a safespot that never moves again.
    if (%inferno_cooldown <= map_clock) {
        %inferno_cooldown = add(map_clock, 2);
        ~inferno_glyph_walk;
    }
    return;
}

%inferno_glyph_stopped = add(%inferno_glyph_stopped, 1);
if (%inferno_glyph_stopped < ^inferno_glyph_pause) {
    return;
}
%inferno_glyph_stopped = 0;
if (%inferno_glyph_dir = ^inferno_dir_west) {
    %inferno_glyph_dir = ^inferno_dir_east;
} else {
    %inferno_glyph_dir = ^inferno_dir_west;
}
~inferno_glyph_walk;

[proc,inferno_glyph_walk]
if (%inferno_glyph_dir = ^inferno_dir_east) {
    npc_walk(^inferno_glyph_east);
    return;
}
npc_walk(^inferno_glyph_west);

// The glyph does not fight back — it only ever walks. Without these the stock
// combat modes would have it chase whoever hit it, and the safespot would follow
// the player around instead of sweeping the arena.
[ai_queue1,inferno_zuk_shield]
npc_setmode(none);

[ai_opplayer2,inferno_zuk_shield]
npc_setmode(none);

[ai_applayer2,inferno_zuk_shield]
npc_setmode(none);

// The glyph is what the waves and Jad shoot at, so it has to be able to take a
// scripted hit as well as a player's. Without this the adds fire at it forever
// and the 600 hitpoints that make tagging them urgent never come off.
//
// Those 600 are the clock the whole fight runs on, and they come off from
// several directions at once, so every hit is reported the same way Zuk's is.
[ai_queue2,inferno_zuk_shield]
def_int $damage = last_int;
// Reported before the damage is applied: ~npc_default_damage returns out of the
// trigger on its own early exits, so anything after the call never runs.
~inferno_report_health("Ancestral Glyph", max(sub(npc_stat(hitpoints), $damage), 0));
~npc_default_damage($damage);

[ai_queue3,inferno_zuk_shield]
npc_anim(npc_param(death_anim), 0);
gosub(npc_default_death);
