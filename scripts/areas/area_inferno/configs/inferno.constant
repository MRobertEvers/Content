// TzKal-Zuk arena. OSRS map square 35_83, so world x = 2240 + local x and
// world z = 5312 + local z; the Kronos coordinates carry over unchanged.

// Zuk stands still at the north end of the arena, facing south.
//
// Kronos spawns him at (2268, 5364) — local 28_52 — but he is seven by seven
// there and LostCity caps npc size at five. A model is drawn centred on its
// footprint, so the same coord with a five-tile footprint renders him a tile
// west and a tile south of where he belongs, visibly off-centre in his alcove.
// Moving the coord one tile in each direction puts the centre back:
// 2269*128 + 5*64 is exactly 2268*128 + 7*64.
^inferno_zuk_coord = 0_35_83_29_53

// The Ancestral Glyph. It spawns embedded in the seal in front of Zuk and
// drops two tiles clear of it as he breaks out, then slides along the lava
// shelf. Kronos spawns the shield at (2270, 5363) and force-walks it south
// twice during the opening; its westShieldPoint/eastShieldPoint are
// (2257, 5361) and (2283, 5361).
//
// A coord is an npc's SOUTH-WEST tile and the glyph is three by three, so
// 5361 is the *south* row of its footprint, not the row it looks like it sits
// on. Left on the spawn row it has its own footprint inside the pillars along
// Zuk's row and cannot take a single step in either direction.
^inferno_glyph_spawn_coord = 0_35_83_30_51
^inferno_glyph_run_coord = 0_35_83_30_49
^inferno_glyph_west = 0_35_83_17_49
^inferno_glyph_east = 0_35_83_43_49
^inferno_glyph_west_x = 2257
^inferno_glyph_east_x = 2283
^inferno_glyph_row_z = 5361
// The glyph's opening, in two waits either side of its two-tile descent:
// it drops out of the seal as soon as the cutscene is under way, then stands
// parked on the arena row for the rest of the pan, and takes its first sweep
// step the moment control returns. Reference footage: the emblem block is
// already down at the lava's edge while the camera is still on Zuk, and it
// starts sliding right as the "Attack" option comes back.
//
// ^inferno_glyph_drop_delay is ticks in the seal before the descent starts.
// ^inferno_glyph_ready_delay is the total opening ticks before the sweep may
// begin, counted on the same clock — the glyph's timer starts one tick after
// npc_add, so a value of N means "first sweep step at T0+N". The cutscene
// holds the player for ^inferno_cutscene_ticks (10).
^inferno_glyph_drop_delay = 3
^inferno_glyph_ready_delay = 11

// The seal. Three pieces of scenery hold Zuk in the wall, and the opening of
// the fight is him breaking out of all of them — Kronos removes the glyph
// outright and collapses the two rocks (swap to a broken variant, play seq
// 7561, remove four ticks later) before handing over to the encounter.
//
// The glyph loc is the base region's copy of the npc we spawn: left in place
// it draws a second, motionless glyph on top of the moving one, and its
// collision is the one obstruction on the glyph's runway. The two rocks flank
// Zuk in his alcove and are non-blocking, so they are purely something to look
// at that should not still be there once he is out.
^inferno_glyph_loc_coord = 0_35_83_30_51
^inferno_rock_coord_west = 0_35_83_28_52
^inferno_rock_coord_east = 0_35_83_33_52

// What is left lying either side of him once they have come down. Kronos turns
// the standing loc at (2275, 5364) into its low form and drops three more in,
// two to Zuk's west and one to his east, all centrepiece_straight — so it ends up
// rubble-strewn rather than simply emptied.
^inferno_rubble_change_coord = 0_35_83_35_52
^inferno_rubble_coord_west_near = 0_35_83_27_52
^inferno_rubble_coord_west_far = 0_35_83_27_54
^inferno_rubble_coord_east_far = 0_35_83_35_54
^inferno_rubble_angle_west = 1
^inferno_rubble_angle_east = 3

// The rocks that flank Zuk. These are not in the square's loc data at all —
// Kronos places them when it builds the arena, on LEVEL 1, one either side of
// him, and takes down the nine-by-four marker at (2267, 5368) at the same time:
//
//   forObj(30356, 2267, 5368, 1, remove)
//   spawn(30346, 2268, 5364, 1, shape 10, angle 3)
//   spawn(30345, 2273, 5364, 1, shape 10, angle 3)
//
// The marker is a multiloc (varbit 5652) with no geometry of its own, which is
// why it exports invisible; removing it is what Kronos does with it anyway, so
// nothing is lost by not being able to express the switch.
//
// The two formations appear via loc_add from [queue,inferno_seal_clear] — the
// tick the falling rocks are removed — simulating the multiloc transform this
// revision cannot express. The ordering is the whole trick, learned twice:
//
//  - Added BEFORE the collapse (on the same tiles: rotated they are 2x5 and
//    their south ends cover the standing rocks' tiles), the add replaces the
//    standing rock, loc_find stops matching, and the collapse silently never
//    plays.
//  - Placed STATICALLY on level 1 (where Kronos spawns them), they stand from
//    tick zero and visually swallow the collapse — the toppling rocks play out
//    inside the crag geometry where nobody can see them.
//
// Added the tick the tiles come free, the opening reads in order: standing
// rocks -> toppling animation -> gone -> crag formations and rubble in their
// place, all inside the cutscene. Level 0, because a zone update carries no
// plane and a scripted level-1 add lands on whatever level the player is on.
^inferno_flank_marker_coord = 1_35_83_27_56
^inferno_flank_coord_west = 0_35_83_28_52
^inferno_flank_coord_east = 0_35_83_33_52
^inferno_flank_angle = 3
// Kronos' collapse timing: swap to the "Falling rock" twin, let go two ticks
// later, clear two ticks after that. The second gap is not arbitrary — the
// collapse seq runs 60 client cycles, which is exactly two server ticks, so
// the rock disappears on the frame the animation finishes on. Both steps are
// scheduled flat from the start of the fight, on Zuk's own npc queues: player
// queues do not run while the cutscene's p_delay holds the player, and on
// them the whole collapse piles up invisibly at the moment control returns.
^inferno_seal_anim_delay = 2
^inferno_seal_anim_ticks = 2
// Ticks the restored seal is on screen before the opening breaks it again —
// ::~zuk resets the arena first, and a reset that is torn down on the same
// tick it lands would never be seen.
^inferno_reset_delay = 2

// Where ::~zuk drops the player in: close enough that Zuk and the glyph are both
// on screen, and lined up behind the glyph's starting column so the first shot
// is a blocked one.
^inferno_player_coord = 0_35_83_31_40

// Phase spawns, from TzKalZuk.java / JalTokJad.java.
^inferno_jad_coord = 0_35_83_30_35
^inferno_mager_coord = 0_35_83_25_38
^inferno_ranger_coord = 0_35_83_35_38
^inferno_healer_coord1 = 0_35_83_40_51
^inferno_healer_coord2 = 0_35_83_36_51
^inferno_healer_coord3 = 0_35_83_26_51
^inferno_healer_coord4 = 0_35_83_22_51

// Zuk fires every 10 ticks and cannot miss; the glyph is the only defence.
// At the healer threshold he enrages and fires three ticks faster — that is
// what takes the two middle safespots away from the player, because there is
// no longer time to cross the arena between shots. The enrage latches: the
// healers that arrive at the same threshold spend the rest of the fight
// pushing him back above it and he does not calm down when they do.
^inferno_zuk_maxhit = 251
^inferno_zuk_attackrate = 10
^inferno_zuk_attackrate_enraged = 7
// He claws his way out of the seal before any of it starts. Kronos locks him
// for the opening cutscene and unlocks him after the dialogue, ten ticks in;
// nothing he does is on the clock until then.
^inferno_zuk_spawn_delay = 10

// The opening cutscene. Kronos pulls the camera back to the mouth of the arena
// at (2276, 5349), turns it on Zuk at (2271, 5365), shakes it on all three axes
// and holds for the dialogue before resetting:
//
//   moveCameraToLocation(2276, 5349, 1000, 10, 100)
//   turnCameraToLocation(2271, 5365, 1000, 10, 100)
//   shakeCamera(0..2, 10)
//
// The player is held for the same span, which is what p_delay does here — it
// suspends the script and leaves them unable to act, so it is both the pacing
// and the lock.
^inferno_cam_from = 0_35_83_36_37
^inferno_cam_to = 0_35_83_31_53
^inferno_cam_height = 1000
^inferno_cam_rate = 10
^inferno_cam_rate2 = 100
// Shake per axis. Kronos passes an intensity of 10; jitter and frequency follow
// the shape the other ported cutscenes use.
^inferno_shake_jitter = 6
^inferno_shake_amplitude = 10
^inferno_shake_frequency = 2
// How long the camera stays on him. Kronos delays 1 before the dialogue and 9
// after it, then resets.
^inferno_cutscene_ticks = 10
// The glyph waits this many ticks at each end before turning around.
^inferno_glyph_pause = 4

// Add waves: the first comes 60 ticks after the glyph is ready, the rest no
// sooner than every 350, and Jad's arrival pushes that out by 175.
^inferno_wave_first = 60
^inferno_wave_interval = 350
^inferno_wave_jad_delay = 175
// Wave spawning holds from the tick Zuk first drops under the first of these
// until he first drops under the second — the window the fight gives you to
// spawn Jad and kill it. It is a one-way latch, not a band: his healers push
// him back up through it later and must not stop the waves a second time.
^inferno_wave_pause_hp = 600
^inferno_wave_resume_hp = 480
// %inferno_wave_gate, tracking which side of that window the fight is on.
^inferno_wave_gate_before = 0
^inferno_wave_gate_paused = 1
^inferno_wave_gate_resumed = 2

// Damage-triggered phases.
^inferno_jad_hp = 480
^inferno_healers_hp = 240
^inferno_jad_maxhit = 113
^inferno_xil_maxhit = 46
^inferno_zek_maxhit = 70
^inferno_mejjak_maxhit = 10

// Healing. The wiki has the Jal-MejJak putting 15-25 back on Zuk every three
// ticks, which is why a wave of them has to be tagged rather than out-damaged.
^inferno_mejjak_heal_min = 15
^inferno_mejjak_heal_max = 25
^inferno_mejjak_heal_rate = 3
^inferno_hurkot_heal_rate = 4
// What a Yt-HurKot hits for once it stops healing and comes for you. The
// Inferno's are level 141 and hit 18 — they are not the Fight Caves ones, which
// is what the 13 here used to assume.
^inferno_hurkot_maxhit = 18
// Once a healer has been hit it stops healing and rains lava balls on the arena
// in front of it. Always three of them, each for 5-10, each landing this many
// ticks after it is fired.
//
// A provoked healer turns to face the player, and where it ends up pointing
// decides which seven-wide column it covers. There are only three answers:
//
//   centre        3 left, its own tile, 3 right
//   turned west   5 left, its own tile, 1 right
//   turned east   1 left, its own tile, 5 right
//
// All seven wide; the window just slides two tiles the way it turned. It picks
// the one that covers the player's column, so the player's position chooses the
// facing but never aims the individual balls.
^inferno_mejjak_band_halfwidth = 3
^inferno_mejjak_band_shift = 2
// How far off its own column the player has to be before it turns rather than
// firing straight ahead — far enough out that the centre band would miss them.
^inferno_mejjak_band_turn = 4
// Depth is measured in from the arena's north edge, never from the player.
^inferno_mejjak_lava_depth = 4
^inferno_mejjak_lava_delay = 3
^inferno_mejjak_lava_min = 5
// Each ball damages the tile it lands on and every tile touching it: a 3x3.
^inferno_mejjak_lava_splash = 1
// The arena's north edge row. The pit is a clean rectangle, local z 17-46, so
// the band above is inside it by construction whichever healer fires.
^inferno_arena_north_z = 5358

// Jad's own healers are Yt-HurKot, not the Jal-MejJak that heal Zuk. Kronos
// spawns wave 69's set in the three-by-three square centred five tiles north of
// Jad's centre; Jad is five wide, so its centre is two tiles in from its coord.
^inferno_jad_healer_dx = 2
^inferno_jad_healer_dz = 7
// They outlive Jad rather than blinking out the instant he dies. His death seq
// runs 154 client cycles — a shade over five server ticks — but the stock death
// path also walks him, waits up to two ticks for him to arrive, and holds a
// further tick before removing him; measured, he leaves eight ticks after the
// trigger. Ten clears all of it with room for the arrive delay to vary.
^inferno_jad_death_ticks = 10

// Where ::~tagheal stands the player: the healers sit on the shelf at z 5363
// and only reach six tiles, so the arena entry point is well outside their
// range and nothing would happen there. This is the north lip of the pit, in
// range of the two middle ones — the same place a player gets bombarded from
// in a real fight.
^inferno_healer_watch_coord = 0_35_83_31_45

// How long a spawned encounter npc lives before the engine reclaims it. Every
// npc_add needs a positive duration, so this doubles as the safety net that
// clears the arena if a fight is abandoned.
^inferno_npc_duration = 5000

// How far the encounter scripts look for their friends. The arena fits inside
// one square, so a single radius covers every lookup.
^inferno_scan_range = 40

// Glyph direction, stored in %inferno_glyph_dir. Zero is left meaning "not
// started yet" so the glyph can initialise itself on its first tick — npc_add
// gives no handle to seed state through.
^inferno_dir_west = 1
^inferno_dir_east = 2
